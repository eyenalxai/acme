# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./packages/env/src/env.d.ts, exposeEnv=none, processEnv=none, importMetaEnv=none, auto=false)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=forEnv(development, test), account=my, cacheTtl=1h)
# ---

# The environment that this process runs against. It selects the `.env.<env>`
# files that varlock layers on top of this schema.
# @public
# @type=enum(development, test, staging, production)
APP_ENV=development

# The absolute origin that serves the app. Better Auth uses it for OAuth redirect
# URIs and for signing absolute links. It has no default on purpose. Every
# environment inherits a default here, and a wrong OAuth callback host fails at
# the provider, not at boot. Development sets the portless URL in
# `.env.development`.
# @public
# @type=url
# @required
APP_URL=

# The Postgres connection string. The default matches the credentials in
# `docker-compose.yml`. Those credentials are already in this repository in
# plaintext, so vaulting them adds ceremony without adding secrecy.
# @type=string(startsWith=postgres)
DATABASE_URL=postgres://acme:acme@localhost:5434/acme

# The 1Password service account token. Setting it makes resolution headless. If
# the value is empty, the token is unused, and `allowAppAuth` then permits the
# desktop app. The desktop app asks for approval once per resolution.
# @type=opServiceAccountToken
OP_TOKEN=

# These three items have no value in this file. Development reads them from
# `.env.local`, which is gitignored. Staging and production receive them as
# injected environment variables. `process.env` has the highest precedence. A
# missing value fails the load in those environments. The shared schema never
# names a vault item.
#
# To read them from 1Password in development, put the references in your own
# `.env.local`:
#
#   BETTER_AUTH_SECRET=op(op://Acme/Local/better-auth-secret)
#
# Signs session cookies and encrypts OAuth state.
# @required=forEnv(staging, production)
BETTER_AUTH_SECRET=

# GitHub OAuth app credentials. The callback URL is
# `${APP_URL}/api/auth/callback/github`.
# The client id is not a secret. It is in the authorize URL that every browser
# visits, and Better Auth returns that URL in a response body. varlock's leak
# scanner aborts any response that contains a sensitive value. Leaving this item
# under `@defaultSensitive` therefore turns every sign-in into a 500. The secret
# below stays sensitive.
# @public
# @docs(https://github.com/settings/developers)
# @required=forEnv(staging, production)
GITHUB_CLIENT_ID=

# @required=forEnv(staging, production)
GITHUB_CLIENT_SECRET=
