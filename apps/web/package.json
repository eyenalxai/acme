{
  "name": "@acme/web",
  "version": "0.0.1",
  "private": true,
  "license": "proprietary",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "vite dev",
    "build": "vite build",
    "start": "varlock run --path ../.. -- bun --bun dist/server/server.js",
    "typegen": "tsr generate",
    "tsc": "bun run typegen && tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint --type-aware --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@acme/api": "workspace:*",
    "@acme/auth": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/ui": "workspace:*",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "better-auth": "1.7.6",
    "effect": "4.0.0-rc.115",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@acme/oxlint-config": "workspace:*",
    "@acme/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.38",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@varlock/vite-integration": "1.5.2",
    "@vitejs/plugin-react": "6.1.1",
    "oxc-transform-react": "0.151.0",
    "portless": "0.15.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "portless": {
    "name": "acme",
    "script": "dev:app"
  },
  "varlock": {
    "loadPath": "../.."
  }
}
