{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": true,
  "globalDependencies": [
    ".env.schema",
    ".env.development",
    "oxlint.config.ts",
    "packages/oxlint-config/src/**",
    "packages/oxlint-config/package.json",
    "packages/typescript-config/*.json",
    "apps/*/oxlint.config.ts",
    "packages/*/oxlint.config.ts"
  ],
  "globalEnv": ["NODE_ENV", "APP_ENV", "VARLOCK_ENV", "APP_URL", "GITHUB_CLIENT_ID"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "GITHUB_CLIENT_SECRET",
    "OP_TOKEN"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^tsc"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^tsc"],
      "outputs": [".output/**", "dist/**"],
      "inputs": ["src/**", "public/**", "*.config.*", "tsconfig.json"]
    },
    "tsc": {
      "dependsOn": ["^tsc"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "*.config.*", "tsconfig.json", "package.json"]
    },
    "typegen": {
      "dependsOn": ["^tsc"],
      "outputs": ["src/routeTree.gen.ts"],
      "inputs": ["src/routes/**", "vite.config.*", "tsr.config.json"]
    },
    "format": {
      "dependsOn": ["^format"],
      "inputs": ["src/**", "*.config.*", "*.json", "*.jsonc"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["src/**", "*.config.*", "tsconfig.json", "package.json"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "auth:generate": {
      "cache": false
    }
  }
}
